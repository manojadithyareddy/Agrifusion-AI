# ═══════════════════════════════════════════════════════════════
#  AgriFusion AI — Root .gitignore
#  Protects ALL secrets, keys, and build artifacts from GitHub
# ═══════════════════════════════════════════════════════════════

# ── Environment / Secrets (NEVER PUSH THESE) ──────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example        # Safe template — ok to push
!**/.env.example

# Backend secrets
backend/.env
backend/.env.*
!backend/.env.example

# Frontend secrets
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example
!frontend/.env.production   # Only push if no secrets inside

# ── Database files ────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/agri.db

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
cover/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# ── ML Model Artifacts & Large Datasets ───────────────────────
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.h5
*.pb
backend/app/ml/models/*.pkl
backend/app/ml/models/*.joblib
backend/app/ml/models/*.pt
backend/app/ml/models/*.onnx
ML Project/
Data/*.csv

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── OS Files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE & Editors ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
tempCodeRunnerFile.py

# ── Vercel ────────────────────────────────────────────────────
.vercel/

# ── Docker ────────────────────────────────────────────────────
docker-compose.override.yml

# ── Misc dev scratch scripts ──────────────────────────────────
backend/fix_*.py
backend/patch_*.py
backend/migrate_*.py
backend/check_*.py
