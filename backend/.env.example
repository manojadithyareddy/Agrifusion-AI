# AgriFusion AI — Environment Variables
# Copy this file to .env and fill in your secrets.

# --- Application ---
APP_NAME=AgriFusion AI
APP_VERSION=0.1.0
DEBUG=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://agrifusion_user:agrifusion_password@localhost:5432/agrifusion_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (CHANGE THESE IN PRODUCTION) ---
SECRET_KEY=CHANGE-ME-random-secret-key-here
JWT_SECRET_KEY=CHANGE-ME-jwt-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Supabase ---
SUPABASE_URL=https://xenrnczedenmvljzlbin.supabase.co
SUPABASE_KEY=sb_publishable_BkmeBl1mAwJl6uQDOctAPw_gtrQwkC-

# --- LLM / GenAI ---
