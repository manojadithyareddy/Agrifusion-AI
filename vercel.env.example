# ─────────────────────────────────────────────────────────────
#  AgriFusion AI — Vercel Environment Variables
#
#  Add ALL of these in:
#  Vercel Dashboard → Your Project → Settings → Environment Variables
#
#  Set environment to: Production (and Preview if needed)
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=AgriFusion AI
APP_VERSION=1.0.0
DEBUG=false

# ── Database (use Vercel Postgres or Neon.tech) ───────────────
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require

# ── Redis (use Vercel KV or Upstash) ─────────────────────────
REDIS_URL=redis://<user>:<password>@<host>:<port>

# ── Auth & Security ───────────────────────────────────────────
SECRET_KEY=<generate: openssl rand -hex 32>
JWT_SECRET_KEY=<generate: openssl rand -hex 32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── RSA Public Key (for RS256 JWT verification) ───────────────
# Paste the full key in one line with \n for newlines:
RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAq6bgE1bSDjFb8oVAAAFW\ndNJT8gYJPIf9slT9ga5Vs+eoXc1HD0Uba9IwQsDC+hnxXue3Xaq04uINLy2chdEh\n5HhXcHh9BzTYXLDMGTkRZ6V9bAVCufWmgBk3h0+hchzsfoSgArbW6E0ZbasSqXas\nLyzkEE8nH3A29dkMJDzLmphVQnRGc3MeiTgVOPTsND7shwJnFDsAMpxeDeBykimU\nMynlIBN5PZKjJcg0yFMMJbLwATREIV3IYA55YWJxaFLL/4WIwLTokpRFrxjpGBpJ\n5/oP3IhrY2lqeOlrR/Ib+DrZVxs15dcNal28v4cBKtOdiMXbwsRAr78gvXhfcEsF\nmQIDAQAB\n-----END PUBLIC KEY-----

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://xenrnczedenmvljzlbin.supabase.co
SUPABASE_KEY=sb_publishable_BkmeBl1mAwJl6uQDOctAPw_gtrQwkC-
VITE_SUPABASE_URL=https://xenrnczedenmvljzlbin.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_BkmeBl1mAwJl6uQDOctAPw_gtrQwkC-

# ── Gemini / LLM ─────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=<your-google-ai-studio-api-key>
GEMINI_API_KEY=<your-google-ai-studio-api-key>

# ── Frontend (set as Vercel env var too) ─────────────────────
VITE_API_URL=https://agrifusion-ai.vercel.app
